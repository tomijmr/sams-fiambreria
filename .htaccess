<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Permitir acceso a archivos y directorios reales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Sirve assets desde /public/assets manteniendo URL amigable /assets/*
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    
    # Enruta todo al front controller dentro de /public
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>

DirectoryIndex index.php

# Bloqueamos acceso directo a ciertos archivos
<FilesMatch "\.(env|sql|md)$">
    Deny from all
</FilesMatch>
